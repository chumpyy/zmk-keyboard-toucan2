#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
&mt LEFT_ALT TAB  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &mt LEFT_ALT PRINTSCREEN  &caps_word  &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI  &kp SQT  &kp LSHFT  &mt LCTRL Z  &mt LEFT_GUI X  &mt LEFT_ALT C  &kp V  &kp B  &kp N  &kp M  &mt LALT COMMA  &mt LEFT_GUI DOT  &mt LCTRL SLASH  &kp ESC  &lt 3 LEFT_GUI  &mo 1  &sk LEFT_SHIFT  &kp RET  &lt 2 SPACE  &mo 1
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
&none  &kp F2  &kp LC(F5)  &kp LG(E)  &kp LA(LC(R))  &kp LC(T)  &kp LC(Y)  &kp HOME  &kp UP_ARROW  &kp END  &none  &kp LS(DELETE)  &kp LC(LEFT_SHIFT)  &kp LC(A)  &kp LC(S)  &kp LS(F3)  &kp LC(F)  &kp F3  &kp DEL  &kp LEFT  &kp DOWN  &kp RIGHT  &kp DEL  &none  &kp LSHFT  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp F12  &kp PAGE_UP  &kp LS(LC(LEFT))  &none  &kp LS(LC(RIGHT))  &kp PAGE_DOWN  &kp RIGHT_SHIFT  &bootloader  &none  &none  &kp LEFT_SHIFT  &kp BACKSPACE  &kp LGUI
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
&kp TILDE  &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp AMPS  &kp KP_MULTIPLY  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDER  &kp LS(DEL)  &kp GRAVE  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0  &kp BSLH  &kp PIPE  &kp LEFT_SHIFT  &kp LS(SLASH)  &none  &none  &kp CARET  &kp NUMBER_6  &kp CARET  &none  &kp COMMA  &kp DOT  &kp SLASH  &kp RIGHT_SHIFT  &kp LGUI  &kp BACKSPACE  &mo 3  &trans  &none  &bootloader
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
&kp K_VOLUME_UP  &kp LC(NUMBER_1)  &kp LC(LG(NUMBER_2))  &kp LC(LG(NUMBER_3))  &kp LC(LG(NUMBER_4))  &kp LC(LG(N5))  &kp F6  &kp C_MUTE  &kp LC(LA(UP_ARROW))  &trans  &trans  &bt BT_NXT  &kp K_MUTE  &kp LG(NUMBER_1)  &kp LG(NUMBER_2)  &kp LG(NUMBER_3)  &kp LG(NUMBER_4)  &kp LG(N5)  &none  &kp LS(LG(LEFT))  &kp LC(LA(DOWN))  &kp LS(LG(RIGHT))  &none  &bt BT_PRV  &kp K_VOLUME_DOWN  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12  &none  &kp LEFT_GUI  &kp K_MUTE  &mt LEFT_GUI ENTER  &kp LEFT_SHIFT  &kp LCTRL
            >;
        };

        mouse {
            display-name = "MOU";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MCLK  &mkp LCLK  &mkp RCLK  &mkp LCLK  &mkp RCLK  &mkp MCLK
            >;
        };

        extra_2 { status = "reserved"; };

        extra_3 { status = "reserved"; };

        layer_7 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
